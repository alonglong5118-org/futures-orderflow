# ==============================================================================
#  Bandit 安全扫描配置
# ==============================================================================
#  扫描 Python 代码中的常见安全问题
#  文档：https://bandit.readthedocs.io/
# ==============================================================================

# 排除的目录
exclude_dirs:
  - .git
  - __pycache__
  - tests
  - ponytail
  - htmlcov
  - coverage-html
  - test-results
  - benchmark-results
  - ga_v*_result
  - "*_backtest_result"

# 排除的文件模式（glob 匹配）
exclude:
  - "*.bak"
  - "*.bak_*"
  - "_*.py"
  - "run_tests.py"

# 只报告 High 严重级别为阻塞级
# Medium 级别作为建议级在 CI 中单独跑
severity: high

# 置信度要求
confidence: medium

# 输出格式
format: txt
