# ==============================================================================
#  Bandit 安全扫描配置（YAML 格式）
# ==============================================================================
#  扫描 Python 代码中的常见安全问题
#  文档：https://bandit.readthedocs.io/
# ==============================================================================

---
# 排除的目录
exclude_dirs:
  - .git
  - __pycache__
  - tests
  - ponytail
  - htmlcov
  - coverage-html
  - test-results
  - benchmark-results

# 排除的测试（跳过特定的安全检查）
# B324: MD5 用于非安全用途（缓存 key 等）
skips: []
