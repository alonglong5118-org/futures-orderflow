# coverage.py 配置文件
# 用法: python run_tests.py --coverage

[run]
source = .
omit =
    # ============================================================
    #  测试文件本身
    # ============================================================
    tests/*
    test_*.py
    */__pycache__/*
    *.pyc

    # ============================================================
    #  入口脚本
    # ============================================================
    run_tests.py

    # ============================================================
    #  备份文件
    # ============================================================
    *.bak_*

    # ============================================================
    #  临时 / 探针 / 诊断脚本（_ 开头）
    # ============================================================
    _*.py

    # ============================================================
    #  遗传算法优化脚本（一次性脚本，非库代码）
    # ============================================================
    ga_*.py

    # ============================================================
    #  工具脚本（非核心库代码）——按后缀模式
    # ============================================================
    scripts/*
    verify_*.py
    *_backtest.py
    *_simulate.py
    *_sweep.py
    *_compare.py
    *upgrade*.py
    bump_version.py

    # ============================================================
    #  回测 / 分析 / 报告类脚本（非库代码）——显式列出
    # ============================================================
    regression_test.py
    perf_breakdown.py
    discipline_review.py
    sr_threshold_validation.py
    sr_exit_ablation.py
    oos_weight_validation.py
    wf_validation.py
    long_hu_bang.py
    apply_blended_weights.py
    signal_explain.py
    four_dim_calibrate.py
    four_dim_recalibrate.py
    four_dim_papertrack.py
    four_dim_live_runner.py
    gen_papertrack_html.py
    backtest_viz.py
    diag_p02_gaps.py
    batch_5m_exit_45.py
    quant_dir_src_45.py
    montecarlo.py
    sentiment_backtest.py
    sentiment_sr_combined_bt.py
    sr_filter_backtest_compare.py
    sr_filter_simulate.py
    sr_exit_adjust_backtest.py
    sr_widen_stop_backtest.py
    sr_widen_sweep.py
    unified_oos_compare.py
    four_dim_oos_compare.py
    four_dim_v51_backtest.py
    four_dim_v51_compare.py
    ga_oos_validation.py
    ga_robust_oos_compare.py
    ga_vs_default_compare.py
    viz_upgrade.py

    # ============================================================
    #  数据源 / 经纪商 / 实盘运行（依赖外部 API，不适合单元测试）
    # ============================================================
    minishare_live.py
    minishare_permission_check.py
    minishare_feed.py
    tushare_live.py
    akshare_live.py
    backend_tqsdk.py
    broker_import.py
    preflight_check.py
    live_health_check.py
    push_notify.py
    execution_planner.py
    tick_orderflow.py
    market_scanner.py
    data_quality.py
    convert_min5_cache.py
    fetch_macro_context.py
    fetch_macro_context_full.py
    fetch_info_dimension.py
    account_monitor.py
    account_tracker.py
    trade_journal.py
    drawdown_guard.py
    refresh_main_contracts.py
    continue_tail_tq.py
    blunder_check.py
    fundamental_feed.py
    fundamental_metrics.py
    feature_manager.py
    calibration.py
    gbm_garch.py
    regime_hmm.py
    new_factor_explorer.py
    symbol_screener.py
    macro_context.py
    self_check.py
    fix_cpos.py
    patch_sym_picker.py
    diagnose_t_seasonal.py
    sentiment_engine.py

    # ============================================================
    #  第三方代码
    # ============================================================
    ponytail/*
    node_modules/*
    .venv/*
    venv/*

[report]
# 显示精度
precision = 1
# 跳过 100% 覆盖的文件，只看需要改进的
skip_covered = false
# 按覆盖率排序
sort = Cover
# 排除的文件模式
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__.:
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __debug__:
    pass

[html]
directory = htmlcov

[xml]
output = coverage.xml
