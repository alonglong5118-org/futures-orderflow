# ==============================================================================
#  Futures OrderFlow · Docker 环境变量示例
#
#  用法：
#    1. 复制本文件为 .env
#    2. 根据实际情况修改配置
#    3. docker compose up -d 启动
# ==============================================================================

# ── Python 版本 ──────────────────────────────────────────────────────────────
PYTHON_VERSION=3.11

# ── 镜像标签 ──────────────────────────────────────────────────────────────────
TAG=latest

# ── 运行配置 ──────────────────────────────────────────────────────────────────
# 面板端口（宿主机映射端口）
PORT=8741

# 运行模式：watchdog（看门狗自动重启）/ direct（直连前台）
MODE=watchdog

# 关闭语音：0=开启语音，1=关闭语音
NO_VOICE=0

# 看门狗卡死判定秒数（连续无响应多久判定卡死）
WATCHDOG_STALL=90

# 看门狗重启间隔（秒）
WATCHDOG_RESTART=4

# ── 数据源 Token ─────────────────────────────────────────────────────────────
# Tushare Pro Token（可选，不填则降级到 akshare）
TUSHARE_TOKEN=

# Akshare 无需 token

# ── 文档站 ───────────────────────────────────────────────────────────────────
# 文档站端口（仅启用 docs profile 时有效）
DOCS_PORT=8742
